<style>
:root{--navy:#0f2d5c;--navy2:#143a73;--gold:#e8b923;--blue:#3a7bd5;--paper:#fbfaf6;--ink:#1d2433;--muted:#5b6478;--line:#e3e0d6}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:72px}
body{font-family:Georgia,"Times New Roman",serif;background:var(--paper);color:var(--ink);line-height:1.7;padding-top:env(safe-area-inset-top,0px)}
h1,h2,h3{font-family:"Helvetica Neue",Arial,sans-serif;letter-spacing:.02em;color:var(--navy)}
img{max-width:100%;display:block}
a{color:var(--navy)}
.wrap{max-width:1040px;margin:0 auto;padding:0 22px}
/* nav */
nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(15,45,92,.94);backdrop-filter:blur(8px);padding-top:env(safe-area-inset-top,0px);transition:box-shadow .3s}
nav.scrolled{box-shadow:0 4px 20px rgba(0,0,0,.25)}
nav .wrap{display:flex;align-items:center;justify-content:space-between;height:60px}
.brand{display:flex;align-items:center;gap:10px;color:#fff;text-decoration:none;font-family:"Helvetica Neue",Arial,sans-serif;font-weight:700;font-size:15px;letter-spacing:.08em}
.brand img{width:36px;height:36px;border-radius:50%;background:#fff}
nav ul{display:flex;gap:20px;list-style:none}
nav a.l{color:#dfe7f5;text-decoration:none;font-family:"Helvetica Neue",Arial,sans-serif;font-size:13px;letter-spacing:.08em;text-transform:uppercase;position:relative}
nav a.l::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--gold);transition:width .3s}
nav a.l:hover::after{width:100%}
@media(max-width:720px){nav ul{display:none}}
/* hero */
.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;text-align:center;position:relative;overflow:hidden;background:radial-gradient(ellipse at 50% 30%,#1b4a8c 0%,var(--navy) 55%,#081a36 100%);color:#fff;padding:90px 0 60px}
.hero::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(115deg,rgba(255,255,255,.035) 0 2px,transparent 2px 22px);pointer-events:none}

.hero .logo{width:min(300px,62vw);margin:0 auto 26px;filter:drop-shadow(0 14px 40px rgba(0,0,0,.45));animation:rise 1.2s ease both}
.hero h1{color:#fff;font-size:clamp(28px,5vw,48px);font-weight:700;animation:rise 1.2s .15s ease both}
.hero .motto{margin-top:14px;font-style:italic;color:var(--gold);font-size:clamp(17px,2.4vw,21px);animation:rise 1.2s .3s ease both}
.hero .cta{display:inline-block;margin-top:34px;padding:13px 30px;border:1.5px solid var(--gold);color:var(--gold);text-decoration:none;font-family:"Helvetica Neue",Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;font-size:13px;transition:all .3s;animation:rise 1.2s .45s ease both}
.hero .cta:hover{background:var(--gold);color:var(--navy)}
@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s ease,transform .9s ease}
.reveal.in{opacity:1;transform:none}
section{padding:90px 0}
section h2{font-size:clamp(24px,3.4vw,34px);font-weight:700;margin-bottom:10px}
.kicker{font-family:"Helvetica Neue",Arial,sans-serif;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:8px}
.rule{width:56px;height:3px;background:var(--gold);margin:14px 0 30px}
.alt{background:#f2efe6}
.cols{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start}
@media(max-width:760px){.cols{grid-template-columns:1fr}}
.card{background:#fff;border:1px solid var(--line);border-top:3px solid var(--navy);padding:26px;border-radius:4px;transition:transform .35s,box-shadow .35s}
.card:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(15,45,92,.12)}
.card h3{font-size:17px;margin-bottom:8px}
.card p{font-size:15px;color:var(--muted)}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;margin-top:10px}
@media(max-width:860px){.grid3{grid-template-columns:1fr}}
.flame-box{background:linear-gradient(160deg,var(--navy),#081a36);color:#fff;padding:34px;border-radius:4px;text-align:center}
.flame-box p{color:#dfe7f5}
.flame-box .lead{font-size:20px;font-style:italic;color:var(--gold);margin:6px 0 14px}
/* statute */
.art{border-left:3px solid var(--gold);padding:12px 0 12px 20px;margin:18px 0}
.art b{font-family:"Helvetica Neue",Arial,sans-serif;color:var(--navy)}
.tag{display:inline-block;font-family:"Helvetica Neue",Arial,sans-serif;font-size:11px;letter-spacing:.12em;text-transform:uppercase;background:var(--navy);color:#fff;padding:3px 9px;margin-bottom:10px}
.btn{display:inline-block;margin-top:18px;padding:12px 26px;background:var(--navy);color:#fff;text-decoration:none;font-family:"Helvetica Neue",Arial,sans-serif;font-size:13px;letter-spacing:.1em;text-transform:uppercase;transition:background .3s}
.btn:hover{background:var(--gold);color:var(--navy)}
/* hierarchy */
.ladder{display:flex;flex-direction:column;align-items:center;gap:8px;margin-top:20px}
.step{width:min(420px,92%);background:#fff;border:1px solid var(--line);border-left:4px solid var(--gold);padding:12px 18px;display:flex;justify-content:space-between;align-items:center;font-family:"Helvetica Neue",Arial,sans-serif;font-size:14px;color:var(--navy);font-weight:600;transition:transform .3s}
.step:hover{transform:translateX(6px)}
.step small{color:var(--muted);font-weight:400}
/* cariche with skins */
.people{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
@media(max-width:860px){.people{grid-template-columns:1fr}}
.person{background:#fff;border:1px solid var(--line);padding:28px 22px;text-align:center;transition:transform .35s,box-shadow .35s}
.person:hover{transform:translateY(-6px);box-shadow:0 18px 34px rgba(15,45,92,.15)}
.avatar{width:190px;height:190px;max-width:100%;object-fit:contain;margin:0 auto 14px;display:block;transform:none;animation:none;background:none}
@media (prefers-reduced-motion:reduce){
.person .role{font-family:"Helvetica Neue",Arial,sans-serif;font-size:12px;letter-spacing:.15em;text-transform:uppercase;color:var(--blue)}
.person .name{font-family:"Helvetica Neue",Arial,sans-serif;font-size:20px;font-weight:700;color:var(--navy);margin:6px 0 8px}
.person p{font-size:14px;color:var(--muted)}
/* footer */
footer{background:var(--navy);color:#cfd8e8;padding:50px 0 30px;font-size:14px}
footer a{color:var(--gold)}
footer .row{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px}
footer .fine{margin-top:26px;font-size:12px;color:#8fa0bd;text-align:center}
/* modal privacy */
.modal{position:fixed;inset:0;background:rgba(8,26,54,.7);display:none;align-items:center;justify-content:center;z-index:70;padding:20px}
.modal.show{display:flex}
.modal .box{background:#fff;max-width:720px;width:100%;max-height:85vh;overflow:auto;padding:30px;position:relative}
.modal .x{position:absolute;right:14px;top:10px;background:none;border:0;font-size:26px;cursor:pointer;color:var(--navy)}
.modal h3{margin:18px 0 6px;font-size:16px}
.modal p{font-size:14px;color:var(--ink);margin-bottom:8px}
.draft{background:#fff7d6;border:1px solid var(--gold);padding:10px 14px;font-size:13px;margin-bottom:16px;font-family:"Helvetica Neue",Arial,sans-serif}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}.reveal{opacity:1;transform:none}}
